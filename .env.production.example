# Application environment
NODE_ENV=production
PORT=3000

# PostgreSQL Production Database Connections
DB_HOST=postgres
DB_PORT=5432
DB_USER=hapanamy_admin
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_NAME=hapanamy_mlm

# Redis Cache connection
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Token configuration
JWT_SECRET=YOUR_SECURE_JWT_SIGNING_KEY_HERE

# Private file uploads storage directory
PRIVATE_STORAGE_PATH=./storage/private

# System Constants
DAILY_COMMISSION_CAP=30000.00
MIN_WITHDRAWAL_AMOUNT=1000.00
REFUND_WINDOW_DAYS=14
