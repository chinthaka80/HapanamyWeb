# ==============================================================================
# HAPANAMY.LK — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
APPLICATION_URL=https://hapanamy.lk

# Database Connection (PostgreSQL / Supabase Transaction Pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:your_strong_password@db.your-supabase-project.supabase.co:5432/postgres

# Security Secrets (Must be 64-character random hexadecimal strings in production)
SESSION_SECRET=e7b4c91a083f2e519283748501928374e7b4c91a083f2e519283748501928374
AUTH_SECRET=928374e7b4c91a083f2e519283748501e7b4c91a083f2e519283748501928374

# Transactional SMTP Mail Settings (For Registration & Security Alerts)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_or_mailgun_api_key
EMAIL_FROM="Hapanamy.lk Support" <noreply@hapanamy.lk>

# Cloudflare & Reverse Proxy Settings
TRUST_PROXY=true

# Private Document Storage (S3 / Supabase Storage for KYC & Slips)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=private-kyc-vault
STORAGE_ENDPOINT=https://your-supabase-project.supabase.co/storage/v1
STORAGE_ACCESS_KEY=your_storage_service_key

# Business & Financial Invariants (Immutable System Defaults)
DIRECT_COMMISSION_PERCENT=8.00
BINARY_COMMISSION_PERCENT=7.00
MAX_QUALIFIED_UPLINE_RECIPIENTS=7
DAILY_EARNINGS_CAP_LKR=30000.00
TIMEZONE=Asia/Colombo
